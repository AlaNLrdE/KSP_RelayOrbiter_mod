<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure orbital math, no Unity/KSP references.
       net472: loaded by KSP (its Mono runtime ships no netstandard.dll facade).
       netstandard2.0: referenced by the net8.0 test project. -->
  <PropertyGroup>
    <TargetFrameworks>net472;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>RelayOrbiter.Core</RootNamespace>
  </PropertyGroup>

</Project>
